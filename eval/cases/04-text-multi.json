              "status": "matched",
              "location": "Job Sites/Smith Residence"
            },
            "flags": []
          },
          {
            "movement_type": "return",
            "line_items": [
              {
                "item_text": "ONT",
                "quantity": 1,
                "unit": null,
                "item_text_accept": [
                  "dead ONT",
                  "old one"
                ],
                "match": {
                  "status": "matched",
                  "part": "ONT-OD-G1"
                }
              }
            ],
            "source_text": "Smith residence",
