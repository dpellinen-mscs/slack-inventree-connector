{
  "display_information": {
    "name": "stockthread",
    "description": "Turns stock posts into InvenTree movements: dry runs by default, writes once an admin enables them.",
    "background_color": "#2c3e50"
  },
  "features": {
    "bot_user": {
      "display_name": "stockthread",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["channels:history", "groups:history", "chat:write"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
